rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Check max file size (15MB)
    function isValidFileSize() {
      return request.resource.size < 15 * 1024 * 1024;
    }
    
    // Allowed content types: PDF, images
    function isValidContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    function isAdmin() {
      return request.auth != null && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/admin/$(request.auth.uid))
      );
    }

    // Player document storage: players have read-only access; only Admin can upload/delete documents
    match /player_documents/{playerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin() &&
                      isValidFileSize() &&
                      isValidContentType();
      allow delete: if isAdmin();
    }

    // Deny all other arbitrary paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
