rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Check max file size (15MB)
    function isValidFileSize() {
      return request.resource.size < 15 * 1024 * 1024;
    }
    
    // Allowed content types: PDF, images
    function isValidContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // Player document storage: players upload only to their own folder
    match /player_documents/{playerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == playerId &&
                      isValidFileSize() &&
                      isValidContentType();
      allow delete: if request.auth != null && request.auth.uid == playerId;
    }

    // Deny all other arbitrary paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
